{
  "name": "eleccions-sant-joan",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestió i repartiment de fanals electorals de Sant Joan de Vilatorrada",
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "dev": "npm start",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
