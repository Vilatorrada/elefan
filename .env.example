# Port intern de l'aplicació (per defecte 3001)
PORT=3001

# Entorn d'execució ('production' desactiva l'accés ràpid sense contrasenya)
NODE_ENV=production

# Directori persistent on es desa la base de dades SQLite WAL (`eleccions.sqlite`, al Dockerfile ja ve predefinit com /app/data)
DATA_DIR=/app/data

# Clau secreta llarga i aleatòria per signar els tokens de sessió HMAC-SHA256 (OBLIGATORI canviar en producció)
AUTH_SECRET=canvia-aquesta-clau-per-una-cadena-llarga-i-aleatoria

# Credencials d'administració municipal (sobreescriuen les de db.json si es defineixen)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=canvia-aquesta-contrasenya-segura

# Opcional: posar a 'true' només si voleu mostrar els botons d'accés ràpid de prova en un entorn de test
ENABLE_DEMO_LOGIN=false
